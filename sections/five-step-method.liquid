{%- comment -%}
  The five-step method. Replaces the old four-step "ritual" section.

  This section teaches the system before asking anyone to buy, which is why it
  sits directly under the hero and above the product grid. The brochure is
  explicit that these are not five things to layer on every day - they are five
  areas of maintenance to address across a week - so each card carries a
  frequency, and the frequency comes from the product's own
  custom.use_frequency metafield rather than section copy. One source, three
  places: this card, the weekly guide and the product page.

  Step 01 has no photography and is not purchasable yet, so the card has to
  degrade properly: a branded placeholder rather than Shopify's grey icon, no
  price, and a Coming soon state instead of a dead Add button.
{%- endcomment -%}

{%- liquid
  assign anchor = section.settings.anchor_id | default: 'five-step-method'
-%}

<section id="{{ anchor }}" class="section {{ section.settings.surface }}">
  <div class="container">

    <div class="ritual__head">
      <div style="max-width:56ch;">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 style="margin-bottom:0.75rem;">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <div class="lede">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link }}" class="btn btn--secondary">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>

    <ol class="ritual__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product

          assign coming_soon = false
          if p.metafields.custom.coming_soon.value
            assign coming_soon = true
          endif

          comment
            Block setting wins when a merchant has typed one, otherwise the
            product's own metafield. Keeps the theme editor useful without
            making the section the source of truth.
          endcomment
          assign frequency = block.settings.frequency | default: p.metafields.custom.use_frequency.value

          assign card_image = block.settings.image | default: p.featured_image
        -%}

        <li class="step-card{% if coming_soon %} step-card--soon{% endif %}"
            data-reveal data-reveal-delay="{{ forloop.index0 | times: 90 }}"
            {{ block.shopify_attributes }}>

          <span class="step-card__num" aria-hidden="true">{{ block.settings.step_number }}</span>

          <div class="step-card__media">
            {%- if card_image != blank -%}
              <img src="{{ card_image | image_url: width: 700 }}"
                   srcset="{{ card_image | image_url: width: 400 }} 400w,
                           {{ card_image | image_url: width: 700 }} 700w"
                   sizes="(min-width: 990px) 260px, 45vw"
                   alt="{{ card_image.alt | escape | default: p.title }}"
                   width="{{ card_image.width }}" height="{{ card_image.height }}"
                   loading="lazy">
            {%- else -%}
              {%- comment -%}
                Art-directed stand-in. A bare Shopify placeholder next to four
                finished product photographs reads as a broken image, not as a
                product that has not launched. This is drawn from the palette,
                so it needs no uploaded asset and themes itself. The moment a
                real photograph is attached to the product it wins above.
              {%- endcomment -%}
              <div class="step-card__placeholder" aria-hidden="true">
                {% render 'icon', name: 'droplet', size: 40 %}
              </div>
            {%- endif -%}
          </div>

          <div class="step-card__body">
            {%- if block.settings.step_label != blank -%}
              <span class="step-card__label">{{ block.settings.step_label }}</span>
            {%- endif -%}

            <h3 class="step-card__title">
              {%- if p != blank -%}
                <a href="{{ p.url }}">{{ block.settings.title | default: p.title }}</a>
              {%- else -%}
                {{ block.settings.title }}
              {%- endif -%}
            </h3>

            {%- if frequency != blank -%}
              <p class="step-card__freq">{{ frequency }}</p>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="step-card__desc">{{ block.settings.description }}</p>
            {%- endif -%}

            <div class="step-card__foot">
              {%- if coming_soon -%}
                {%- comment -%}
                  No price. A figure with nothing to click invites "why can't I
                  buy this", and the figure on this product is a placeholder
                  anyway.
                {%- endcomment -%}
                <span class="badge badge--soon">{{ 'products.product.coming_soon' | t }}</span>
                {%- if section.settings.notify_link != blank -%}
                  <a class="step-card__notify" href="{{ section.settings.notify_link }}">
                    {{ 'products.product.notify_me' | t }}
                  </a>
                {%- endif -%}

              {%- elsif p != blank -%}
                {% render 'price', product: p %}
                {%- if p.available and p.variants.size == 1 -%}
                  <product-form style="position:relative;z-index:2;">
                    {%- form 'product', p, id: null -%}
                      <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                      <button type="submit" class="btn btn--secondary"
                              style="min-height:38px;padding-inline:1rem;font-size:11px;">
                        <span data-btn-label>{{ 'products.product.add_short' | t }}</span>
                        <span data-btn-spinner hidden>{% render 'icon', name: 'spinner', size: 14 %}</span>
                      </button>
                    {%- endform -%}
                  </product-form>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.footnote != blank -%}
      <p class="five-step__footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Five-step method",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Five cards, in routine order. Each card takes its frequency from the product's Use frequency metafield, and shows a Coming soon state when the product's Coming soon metafield is on."
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "options": [
        { "value": "surface-bone", "label": "Canvas" },
        { "value": "surface-tint", "label": "Canvas tint" },
        { "value": "surface-sage", "label": "Olive wash" },
        { "value": "surface-paper", "label": "Ivory" }
      ],
      "default": "surface-tint"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor",
      "default": "five-step-method",
      "info": "Used by links such as /#five-step-method. Change this and any menu link pointing at it must change too."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Intelligent skin maintenance" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Five essentials." },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>One complete approach to skin maintenance. These are not five things to layer on every day. Think of them as five areas to address across the week, according to how your skin looks and feels.</p>"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Understand what your skin needs. Choose the appropriate step. Maintain it consistently."
    },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    {
      "type": "url",
      "id": "notify_link",
      "label": "Coming soon link",
      "info": "Where the Notify me link on a Coming soon card points. Usually the email signup."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Leave empty to use the product's featured image."
        },
        { "type": "text", "id": "step_number", "label": "Step number", "default": "1" },
        {
          "type": "text",
          "id": "step_label",
          "label": "Step",
          "default": "Hydrate",
          "info": "The verb only, e.g. Hydrate. The number is set above."
        },
        { "type": "text", "id": "title", "label": "Title override" },
        {
          "type": "text",
          "id": "frequency",
          "label": "Frequency override",
          "info": "Leave empty to use the product's Use frequency metafield."
        },
        {
          "type": "text",
          "id": "description",
          "label": "Purpose",
          "info": "One short line. What this step is for, not the ingredient list."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Five-step method",
      "blocks": [
        { "type": "step", "settings": { "step_number": "1", "step_label": "Hydrate",    "title": "Mineral Veil" } },
        { "type": "step", "settings": { "step_number": "2", "step_label": "Lubricate",  "title": "Frank Castor" } },
        { "type": "step", "settings": { "step_number": "3", "step_label": "Tone",       "title": "Rice Toner" } },
        { "type": "step", "settings": { "step_number": "4", "step_label": "Nourish",    "title": "Rice Silk Serum" } },
        { "type": "step", "settings": { "step_number": "5", "step_label": "Moisturize", "title": "Orchid Lotion" } }
      ]
    }
  ]
}
{% endschema %}
