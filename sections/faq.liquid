<section class="section {{ section.settings.surface }}">
  <div class="container container--narrow">

    <div class="flow-center" style="margin-bottom:2.5rem;">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <accordion-element class="accordion" {% if section.settings.single_open %}data-single{% endif %}>
      {%- for block in section.blocks -%}
        <div class="accordion__item" {{ block.shopify_attributes }}>
          <h3 style="margin:0;">
            <button
              type="button"
              class="accordion__trigger"
              aria-expanded="false"
              aria-controls="FaqPanel-{{ block.id }}"
              id="FaqTrigger-{{ block.id }}"
            >
              <span>{{ block.settings.question }}</span>
              <span class="accordion__icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div
            class="accordion__panel"
            id="FaqPanel-{{ block.id }}"
            role="region"
            aria-labelledby="FaqTrigger-{{ block.id }}"
            data-open="false"
          >
            <div>
              <div class="accordion__content rte">{{ block.settings.answer }}</div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </accordion-element>

    {%- if section.settings.footer_text != blank -%}
      <p class="flow-center" style="margin-top:2.5rem;color:var(--o-ink-2);">
        {{ section.settings.footer_text }}
      </p>
    {%- endif -%}

  </div>
</section>

{%- comment -%}
  FAQPage structured data. This is what produces the expandable FAQ rows in
  Google - free vertical space on the results page for a brand nobody
  is searching for by name yet.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "options": [
        { "value": "surface-bone", "label": "Bone" },
        { "value": "surface-tint", "label": "Bone tint" },
        { "value": "surface-paper", "label": "Paper" }
      ],
      "default": "surface-bone"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before you ask" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    {
      "type": "checkbox",
      "id": "single_open",
      "label": "Only one open at a time",
      "default": true
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Still deciding? Email hello@original1percent.com and a human will answer."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "What order do I use the four products in?",
            "answer": "<p>Toner first on clean skin, then serum, then lotion last. Frank Castor is the weekly one. Use it once or twice a week on skin or hair, or as the last step at night.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Is this suitable for sensitive skin?",
            "answer": "<p>Yes. Everything is formulated without parabens or harsh chemicals, and the Orchid Lotion is fragrance-free. As with any new product, patch test on your inner arm for 24 hours first.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Where is it made?",
            "answer": "<p>Formulated and filled in a certified facility in Canada, then bottled in recyclable Italian glass.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How long will one bottle last?",
            "answer": "<p>Roughly eight to ten weeks with twice-daily use. The 50mL bottles are sized so the whole ritual runs out at about the same time.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What if it doesn't work for me?",
            "answer": "<p>Return it within 30 days, opened or not, and we'll refund you. Skincare is personal and we would rather you find the right thing.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do you ship outside Canada?",
            "answer": "<p>Yes, we ship across Canada and the United States. Shipping is free on orders over $100.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
