{%- liquid
  assign scheme = section.settings.text_scheme
  assign has_media = false
  if section.settings.image != blank or section.settings.video != blank
    assign has_media = true
  endif

  comment
    With nothing uploaded, fall back to the hero art bundled in assets/ so a
    fresh install is never a bare colour field. That art is composed with a
    bone-toned safe zone on the left for the headline, so it needs dark text
    and no scrim - the merchant's own overlay/scheme settings only apply once
    they upload their own image.
  endcomment
  assign use_bundled_hero = false
  unless has_media
    assign use_bundled_hero = true
    assign scheme = 'dark'
  endunless

  comment
    Art direction: a landscape source cover-cropped into a portrait viewport
    shows roughly its middle third, and which third depends on the handset. A
    purpose-made portrait source removes that entirely. When one exists the
    hero keeps its full-bleed overlay on mobile; when it doesn't, the stylesheet
    falls back to stacking the image above the copy, which is the only safe
    thing to do with a landscape crop.
  endcomment
  assign art_directed = false
  if section.settings.mobile_image != blank
    assign art_directed = true
  endif
  if use_bundled_hero
    assign art_directed = true
  endif
-%}

{%- comment -%}
  hero--bundled tells the stylesheet it is dealing with the shipped artwork,
  which has a known composition (subject right, type-safe field left) and so
  needs a different mobile crop and veil from an arbitrary uploaded photo.
{%- endcomment -%}
<section class="hero {% if scheme == 'light' %}hero--light{% endif %}{% if use_bundled_hero %} hero--bundled{% endif %}{% if art_directed %} hero--art-directed{% endif %}"
         style="--section-pt:0;--section-pb:0;--hero-focal:{{ section.settings.focal_desktop }};--hero-focal-mobile:{{ section.settings.focal_mobile }};">

  {%- if section.settings.video != blank -%}
    <div class="hero__media">
      {{ section.settings.video
         | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false }}
    </div>
  {%- elsif section.settings.image != blank -%}
    <div class="hero__media">
      <picture>
        {%- if section.settings.mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.mobile_image | image_url: width: 600 }} 600w,
                    {{ section.settings.mobile_image | image_url: width: 900 }} 900w,
                    {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w"
            sizes="100vw"
          >
        {%- endif -%}
        <img
          src="{{ section.settings.image | image_url: width: 2000 }}"
          srcset="{{ section.settings.image | image_url: width: 750 }} 750w,
                  {{ section.settings.image | image_url: width: 1100 }} 1100w,
                  {{ section.settings.image | image_url: width: 1500 }} 1500w,
                  {{ section.settings.image | image_url: width: 2000 }} 2000w"
          sizes="100vw"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          fetchpriority="high"
        >
      </picture>
    </div>
  {%- elsif use_bundled_hero -%}
    <div class="hero__media">
      {%- comment -%}
        The bundled set ships both orientations: a 16:9 landscape master and a
        2:3 portrait companion whose type-safe bone field runs across the top
        instead of down the left.
      {%- endcomment -%}
      <picture>
        <source media="(max-width: 749px)" srcset="{{ 'hero-default-mobile.jpg' | asset_url }}">
        <img
          src="{{ 'hero-default.jpg' | asset_url }}"
          alt=""
          width="1600" height="900"
          fetchpriority="high"
        >
      </picture>
    </div>
  {%- endif -%}

  {%- comment -%}
    No scrim over the bundled art - it already carries its own light safe zone,
    and darkening it would muddy the bone field the headline sits on.
  {%- endcomment -%}
  {%- if has_media -%}
    <div class="hero__scrim" style="opacity: {{ section.settings.overlay | divided_by: 100.0 }};"></div>
  {%- endif -%}

  <div class="hero__inner container">
    <div class="hero__content">
      {%- if section.settings.show_lockup -%}
        {%- comment -%}
          The full lockup: mark, wordmark, descriptor and slogan in one image.
          On the light scheme the artwork has to invert, so the bundled fallback
          picks the bone version the same way the header picks its wordmark.
        {%- endcomment -%}
        {%- if section.settings.logo_lockup != blank -%}
          <img
            class="hero__lockup"
            src="{{ section.settings.logo_lockup | image_url: width: 640 }}"
            srcset="{{ section.settings.logo_lockup | image_url: width: 320 }} 1x,
                    {{ section.settings.logo_lockup | image_url: width: 640 }} 2x"
            alt="{{ shop.name }} - {{ settings.brand_tagline }}"
            width="{{ section.settings.logo_lockup.width }}"
            height="{{ section.settings.logo_lockup.height }}"
            fetchpriority="high"
          >
        {%- else -%}
          {%- if scheme == 'light' -%}
            {%- assign lockup_src = 'logo-light.png' -%}
          {%- else -%}
            {%- assign lockup_src = 'logo.png' -%}
          {%- endif -%}
          <img
            class="hero__lockup"
            src="{{ lockup_src | asset_url }}"
            alt="{{ shop.name }} - {{ settings.brand_tagline }}"
            width="620" height="654"
            fetchpriority="high"
          >
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="hero__title">
        {{ section.settings.heading }}
        {%- if section.settings.heading_emphasis != blank -%}
          <em>{{ section.settings.heading_emphasis }}</em>
        {%- endif -%}
      </h1>

      {%- if section.settings.subheading != blank -%}
        <div class="lede">{{ section.settings.subheading }}</div>
      {%- endif -%}

      <div class="hero__actions">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}"
             class="btn btn--lg {% if scheme == 'light' %}btn--light{% endif %}">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a href="{{ section.settings.cta2_link }}"
             class="btn btn--lg btn--secondary"
             {% if scheme == 'light' %}style="color:var(--o-paper);border-color:rgba(250,249,247,0.55);"{% endif %}>
            {{ section.settings.cta2_label }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="hero__proof">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {% render 'icon', name: block.settings.icon, size: 16 %}
              {{ block.settings.text }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Above the fold you have about 3 seconds. Lead with what the brand is, not a slogan the shopper can't decode yet."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (desktop)",
      "info": "Landscape, around 2000 x 1125. Keep the left third clear of detail: the headline sits there."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Background image (mobile)",
      "info": "Portrait, around 1080 x 1620. Keep the top half clear. Without this, a landscape image is stacked above the copy on phones rather than cropped through its middle."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "info": "Overrides the image. Keep it under 8 seconds and under 4 MB. It loads before anything else the shopper can act on."
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Overlay strength",
      "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100,
      "info": "Scales the whole veil. 100% is the tuned setting: it holds 4.5:1 behind the headline even over a pale photograph. Lower values show more of the image and less of the text."
    },
    {
      "type": "paragraph",
      "content": "The copy sits over the photograph on every screen size. If a face or product gets cropped out on phones, move the focal point rather than uploading a second image."
    },
    {
      "type": "select",
      "id": "focal_desktop",
      "label": "Focal point (desktop)",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center center", "label": "Middle" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "focal_mobile",
      "label": "Focal point (mobile)",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center 30%", "label": "Upper middle" },
        { "value": "center center", "label": "Middle" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center 30%",
      "info": "A landscape photo cropped into a tall phone viewport shows only a slice of itself. Upper middle usually keeps a face in frame."
    },
    {
      "type": "select",
      "id": "text_scheme",
      "label": "Text colour",
      "options": [
        { "value": "light", "label": "Light (on imagery)" },
        { "value": "dark", "label": "Dark (on plain background)" }
      ],
      "default": "light"
    },
    { "type": "header", "content": "Brand lockup" },
    {
      "type": "checkbox",
      "id": "show_lockup",
      "label": "Show the full logo lockup",
      "default": true,
      "info": "Mark, wordmark and slogan, above the heading. Ships with the bundled artwork; upload below to replace it."
    },
    {
      "type": "image_picker",
      "id": "logo_lockup",
      "label": "Lockup image",
      "info": "Transparent PNG. Leave empty to use the bundled lockup."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Conscious lifestyle & skincare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Skincare, understood" },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Heading (emphasised line)",
      "default": "in five steps."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Five purposeful formulas organized around a simple, consistent ritual.</p>"
    },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Explore the five steps" },
    { "type": "url", "id": "cta_link", "label": "Primary button link" },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button",
      "info": "Leave empty. The brand style rule is one main button per section. (No default here on purpose: an empty-string default fails Shopify's schema validation and the whole file is rejected on deploy.)"
    },
    { "type": "url", "id": "cta2_link", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Proof point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "maple", "label": "Maple leaf" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "rabbit", "label": "Cruelty-free" },
            { "value": "bottle", "label": "Bottle" },
            { "value": "flask", "label": "Lab" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Shipping" },
            { "value": "check-circle", "label": "Check" }
          ],
          "default": "check-circle"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Paraben-free" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "proof", "settings": { "icon": "maple", "text": "Made in Canada" } },
        { "type": "proof", "settings": { "icon": "leaf", "text": "Paraben-free" } },
        { "type": "proof", "settings": { "icon": "rabbit", "text": "Cruelty-free & vegan" } },
        { "type": "proof", "settings": { "icon": "bottle", "text": "Italian glass" } }
      ]
    }
  ]
}
{% endschema %}
