{%- comment -%}
  The merchandising engine of this store.

  Four SKUs sold individually is four decisions the shopper has to make alone.
  Four SKUs presented as an ordered ritual is one decision - "start the ritual" - with a natural upsell to the full set. Numbering them 0–3 also answers the
  question every skincare shopper silently asks: what goes on first?
{%- endcomment -%}

<section class="section {{ section.settings.surface }}">
  <div class="container">

    <div class="ritual__head">
      <div style="max-width:56ch;">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 style="margin-bottom:0.75rem;">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <div class="lede">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link }}" class="btn btn--secondary">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>

    <div class="ritual__grid">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <article class="step-card" data-reveal data-reveal-delay="{{ forloop.index0 | times: 90 }}"
                 {{ block.shopify_attributes }}>

          <span class="step-card__num" aria-hidden="true">{{ block.settings.step_number }}</span>

          <div class="step-card__media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 700 }}"
                   srcset="{{ block.settings.image | image_url: width: 400 }} 400w,
                           {{ block.settings.image | image_url: width: 700 }} 700w"
                   sizes="(min-width: 990px) 320px, 45vw"
                   alt="{{ block.settings.image.alt | escape | default: p.title }}"
                   width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}"
                   loading="lazy">
            {%- elsif p.featured_image -%}
              <img src="{{ p.featured_image | image_url: width: 700 }}"
                   srcset="{{ p.featured_image | image_url: width: 400 }} 400w,
                           {{ p.featured_image | image_url: width: 700 }} 700w"
                   sizes="(min-width: 990px) 320px, 45vw"
                   alt="{{ p.featured_image.alt | escape | default: p.title }}"
                   width="{{ p.featured_image.width }}" height="{{ p.featured_image.height }}"
                   loading="lazy">
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>

          <div class="step-card__body">
            <span class="step-card__label">{{ block.settings.step_label }}</span>

            <h3 class="step-card__title">
              {%- if p != blank -%}
                <a href="{{ p.url }}">{{ block.settings.title | default: p.title }}</a>
              {%- else -%}
                {{ block.settings.title }}
              {%- endif -%}
            </h3>

            {%- if block.settings.description != blank -%}
              <p class="step-card__desc">{{ block.settings.description }}</p>
            {%- endif -%}

            <div class="step-card__foot">
              {%- if p != blank -%}
                {% render 'price', product: p %}
                {%- if p.available and p.variants.size == 1 -%}
                  <product-form style="position:relative;z-index:2;">
                    {%- form 'product', p, id: null -%}
                      <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                      <button type="submit" class="btn btn--secondary"
                              style="min-height:38px;padding-inline:1rem;font-size:11px;">
                        <span data-btn-label>Add</span>
                        <span data-btn-spinner hidden>{% render 'icon', name: 'spinner', size: 14 %}</span>
                      </button>
                    {%- endform -%}
                  </product-form>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Ritual steps",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "options": [
        { "value": "surface-bone", "label": "Bone" },
        { "value": "surface-tint", "label": "Bone tint" },
        { "value": "surface-sage", "label": "Sage wash" },
        { "value": "surface-paper", "label": "Paper" }
      ],
      "default": "surface-tint"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four steps. In this order." },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Each formula does one job well, and hands off to the next. Start anywhere, but this is the order your skin prefers.</p>"
    },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop all four" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Leave empty to use the product's featured image."
        },
        { "type": "text", "id": "step_number", "label": "Step number", "default": "1" },
        { "type": "text", "id": "step_label", "label": "Step label", "default": "Step 01 · Tone" },
        { "type": "text", "id": "title", "label": "Title override" },
        {
          "type": "text",
          "id": "description",
          "label": "One-line benefit",
          "info": "One benefit, in the shopper's words. Not the ingredient list."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ritual steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": "0",
            "step_label": "Step 00 · Treat",
            "title": "Frank Castor",
            "description": "Cold-pressed castor and frankincense for hair and skin. The weekly deep treatment."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "1",
            "step_label": "Step 01 · Tone",
            "title": "Rice Toner",
            "description": "Rice water, witch hazel and chamomile. Brightens, balances, preps the skin."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "2",
            "step_label": "Step 02 · Treat",
            "title": "Rice Silk Serum",
            "description": "Vitamin C, hyaluronic acid and silk amino acids. Brightening and plumping."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "3",
            "step_label": "Step 03 · Seal",
            "title": "Orchid Lotion",
            "description": "Niacinamide, orchid extract and shea. Locks everything in, fragrance-free."
          }
        }
      ]
    }
  ]
}
{% endschema %}
