<div class="container container--narrow section" style="max-width:460px;">
  <h1 style="text-align:center;">{{ 'customer.reset_password.title' | t }}</h1>
  <p class="lede" style="text-align:center;">{{ 'customer.reset_password.subtext' | t }}</p>

  {%- form 'reset_customer_password', style: 'display:grid;gap:1rem;margin-top:1.5rem;' -%}
    {%- if form.errors -%}
      <p class="field__error" role="alert">{{ form.errors | default_errors }}</p>
    {%- endif -%}

    <div class="field">
      <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
      <input class="input" type="password" id="ResetPassword" name="customer[password]"
             autocomplete="new-password" required>
    </div>

    <div class="field">
      <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
      <input class="input" type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]"
             autocomplete="new-password" required>
    </div>

    <button type="submit" class="btn btn--full btn--lg">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Reset password", "tag": "section", "settings": [] }
{% endschema %}
