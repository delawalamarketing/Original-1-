<div class="container container--narrow section" style="max-width:460px;">
  <h1 style="text-align:center;">{{ 'customer.register.title' | t }}</h1>

  {%- form 'create_customer', style: 'display:grid;gap:1rem;margin-top:1.5rem;' -%}
    {%- if form.errors -%}
      <p class="field__error" role="alert">{{ form.errors | default_errors }}</p>
    {%- endif -%}

    <div class="field">
      <label class="field__label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
      <input class="input" type="text" id="RegisterFirstName" name="customer[first_name]" autocomplete="given-name">
    </div>

    <div class="field">
      <label class="field__label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
      <input class="input" type="text" id="RegisterLastName" name="customer[last_name]" autocomplete="family-name">
    </div>

    <div class="field">
      <label class="field__label" for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
      <input class="input" type="email" id="RegisterEmail" name="customer[email]"
             autocomplete="email" autocapitalize="off" required>
    </div>

    <div class="field">
      <label class="field__label" for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
      <input class="input" type="password" id="RegisterPassword" name="customer[password]"
             autocomplete="new-password" required>
    </div>

    <button type="submit" class="btn btn--full btn--lg">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}

  <hr class="rule">
  <p style="text-align:center;font-size:var(--fs-sm);">
    Already have an account? <a href="{{ routes.account_login_url }}">{{ 'customer.log_in' | t }}</a>
  </p>
</div>

{% schema %}
{ "name": "Register", "tag": "section", "settings": [] }
{% endschema %}
