{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show
-%}

<section class="section {{ section.settings.surface }}">
  <div class="container">

    <div class="ritual__head">
      <div style="max-width:52ch;">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 style="margin-bottom:0.5rem;">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="lede">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- if collection != blank -%}
        <a href="{{ collection.url }}" class="btn btn--secondary">
          {{ section.settings.cta_label | default: 'View all' }}
        </a>
      {%- endif -%}
    </div>

    <div class="collection__grid">
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <article class="card">
            <div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
            <div class="card__body">
              <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
              <div class="card__footer"><span class="price">$33.00</span></div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "options": [
        { "value": "surface-bone", "label": "Bone" },
        { "value": "surface-tint", "label": "Bone tint" },
        { "value": "surface-paper", "label": "Paper" }
      ],
      "default": "surface-bone"
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2, "max": 12, "step": 1, "default": 4
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the ritual" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "View all" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
