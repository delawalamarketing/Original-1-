{%- comment -%}
  Cross-sell on the product page. Shows the other steps in the ritual, with the
  step the shopper is already looking at filtered out — recommending a product
  someone is currently viewing reads as broken and wastes the slot.
{%- endcomment -%}

{%- liquid
  assign source = collections[section.settings.collection]
  assign shown = 0
  assign limit = section.settings.products_to_show
-%}

{%- if source.products.size > 1 -%}
  <section class="section {{ section.settings.surface }}">
    <div class="container">

      <div class="flow-center" style="margin-bottom:2.5rem;">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="lede">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="collection__grid">
        {%- for p in source.products -%}
          {%- unless p.id == product.id -%}
            {%- if shown < limit -%}
              {% render 'product-card', product: p, index: forloop.index0 %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>

    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Complete the ritual",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Usually your 'The Ritual' collection containing all four steps."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2, "max": 6, "step": 1, "default": 3
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "options": [
        { "value": "surface-bone", "label": "Bone" },
        { "value": "surface-tint", "label": "Bone tint" },
        { "value": "surface-sage", "label": "Sage wash" }
      ],
      "default": "surface-tint"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Better together" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete your ritual" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Each step makes the next one work harder. Here's what pairs with this one.</p>"
    }
  ],
  "presets": [{ "name": "Complete the ritual" }]
}
{% endschema %}
