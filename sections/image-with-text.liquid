<section class="section {{ section.settings.surface }}">
  <div class="container">
    <div class="bundle" style="{% if section.settings.layout == 'text_first' %}direction:rtl;{% endif %}">

      <div class="bundle__media" data-reveal
           style="direction:ltr;{% if section.settings.media_shape == 'portrait' %}aspect-ratio:4/5;{% elsif section.settings.media_shape == 'square' %}aspect-ratio:1/1;{% endif %}">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}"
               srcset="{{ section.settings.image | image_url: width: 700 }} 700w,
                       {{ section.settings.image | image_url: width: 1200 }} 1200w"
               sizes="(min-width: 990px) 50vw, 100vw"
               alt="{{ section.settings.image.alt | escape }}"
               width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
               loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>

      <div data-reveal data-reveal-delay="110" style="direction:ltr;">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h2>{{ section.settings.heading }}</h2>

        {%- if section.settings.text != blank -%}
          <div class="lede rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul style="list-style:none;padding:0;margin:1.5rem 0;display:grid;gap:0.75rem;">
            {%- for block in section.blocks -%}
              <li style="display:flex;gap:0.75rem;align-items:flex-start;" {{ block.shopify_attributes }}>
                <span style="color:var(--o-teal);flex:none;margin-top:3px;">
                  {% render 'icon', name: 'check-circle', size: 18 %}
                </span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.signature != blank -%}
          <p style="font-family:var(--font-display);font-size:var(--fs-lg);margin-top:1.5rem;">
            {{ section.settings.signature }}
          </p>
        {%- endif -%}

        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn" style="margin-top:1rem;">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "options": [
        { "value": "surface-bone", "label": "Bone" },
        { "value": "surface-tint", "label": "Bone tint" },
        { "value": "surface-sage", "label": "Sage wash" },
        { "value": "surface-paper", "label": "Paper" }
      ],
      "default": "surface-bone"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "media_first", "label": "Image left" },
        { "value": "text_first", "label": "Image right" }
      ],
      "default": "media_first"
    },
    {
      "type": "select",
      "id": "media_shape",
      "label": "Image shape",
      "options": [
        { "value": "landscape", "label": "Landscape" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" }
      ],
      "default": "landscape"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why we started" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One percent, compounded" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Most skincare asks you to overhaul everything at once. We think the opposite works better: four honest formulas, used consistently, getting you one percent closer to the skin you want every single day.</p><p>Everything is made in a certified Canadian facility, without parabens, and bottled in Italian glass we would happily leave on the counter.</p>"
    },
    { "type": "text", "id": "signature", "label": "Signature" },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [{ "type": "text", "id": "text", "label": "Text" }]
    }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
