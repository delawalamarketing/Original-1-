{%- if section.blocks.size > 0 -%}
  <div class="announcement" style="background: {{ section.settings.bg }}; color: {{ section.settings.fg }};">
    <div class="container">
      <div class="announcement__inner">
        {%- comment -%}
          A single, specific message beats a rotating carousel. Rotation forces
          the shopper to wait for a message they have already half-read.
        {%- endcomment -%}
        {%- for block in section.blocks limit: 1 -%}
          <span {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
          </span>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#263B25" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#E8E4DB" }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on Canadian orders over $100 · Formulated in a certified Canadian facility"
        },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [{ "type": "announcement" }]
  },
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
