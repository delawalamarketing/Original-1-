{%- comment -%}
  Sits immediately under the hero. Its job is to answer the four objections a
  first-time skincare buyer forms before they scroll: is it safe, is it real,
  who made it, and what happens if I don't like it.
{%- endcomment -%}

<section class="trust-bar">
  <div class="container">
    <ul class="trust-bar__list">
      {%- for block in section.blocks -%}
        <li class="trust-bar__item" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon, size: 24 %}
          <span>{{ block.settings.text }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "blocks": [
    {
      "type": "item",
      "name": "Trust point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "maple", "label": "Maple leaf" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "rabbit", "label": "Cruelty-free" },
            { "value": "bottle", "label": "Bottle" },
            { "value": "flask", "label": "Lab" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Shipping" },
            { "value": "return", "label": "Returns" },
            { "value": "lock", "label": "Secure" },
            { "value": "droplet", "label": "Hydration" }
          ],
          "default": "check-circle"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Paraben-free" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "flask", "text": "Certified Canadian facility" } },
        { "type": "item", "settings": { "icon": "leaf", "text": "Paraben & sulphate free" } },
        { "type": "item", "settings": { "icon": "rabbit", "text": "Cruelty-free & vegan" } },
        { "type": "item", "settings": { "icon": "bottle", "text": "Eco-friendly Italian glass" } },
        { "type": "item", "settings": { "icon": "truck", "text": "Free shipping in Canada" } }
      ]
    }
  ]
}
{% endschema %}
