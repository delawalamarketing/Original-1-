<div class="container container--narrow section" style="max-width:460px;">
  <h1 style="text-align:center;">{{ 'customer.activate_account.title' | t }}</h1>
  <p class="lede" style="text-align:center;">{{ 'customer.activate_account.subtext' | t }}</p>

  {%- form 'activate_customer_password', style: 'display:grid;gap:1rem;margin-top:1.5rem;' -%}
    {%- if form.errors -%}
      <p class="field__error" role="alert">{{ form.errors | default_errors }}</p>
    {%- endif -%}

    <div class="field">
      <label class="field__label" for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
      <input class="input" type="password" id="ActivatePassword" name="customer[password]"
             autocomplete="new-password" required>
    </div>

    <div class="field">
      <label class="field__label" for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
      <input class="input" type="password" id="ActivatePasswordConfirm"
             name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>

    <button type="submit" class="btn btn--full btn--lg">{{ 'customer.activate_account.submit' | t }}</button>
    <button type="submit" name="decline" class="btn btn--ghost">{{ 'customer.activate_account.cancel' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Activate account", "tag": "section", "settings": [] }
{% endschema %}
