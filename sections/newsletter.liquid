<section class="section {% if section.settings.color_scheme == 'forest' %}surface-forest{% elsif section.settings.color_scheme == 'sage' %}surface-sage{% else %}surface-tint{% endif %}">
  <div class="container container--narrow">
    <div class="newsletter {% if section.settings.align == 'center' %}newsletter--center{% endif %}"
         {% if section.settings.align == 'center' %}style="text-align:center;"{% endif %}>

      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h2>{{ section.settings.heading }}</h2>

      {%- if section.settings.text != blank -%}
        <div class="lede">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">
          {{ 'general.newsletter.label' | t }}
        </label>
        <input
          class="input"
          id="NewsletterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          autocomplete="email"
          required
          placeholder="{{ 'general.newsletter.placeholder' | t }}"
        >
        <button type="submit" class="btn">{{ section.settings.button_label }}</button>
      {%- endform -%}

      <p class="newsletter__success" data-newsletter-success hidden role="status">
        {{ 'general.newsletter.success' | t }}
      </p>

      {%- if section.settings.disclaimer != blank -%}
        <p style="font-size:var(--fs-xs);color:var(--o-ink-3);margin-top:0.75rem;">
          {{ section.settings.disclaimer }}
        </p>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Email is the highest-ROI channel you own. Offer something concrete — a discount or a ritual guide — not just 'sign up for updates'."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "tint", "label": "Bone tint" },
        { "value": "sage", "label": "Sage wash" },
        { "value": "forest", "label": "Forest" }
      ],
      "default": "sage"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the 1%" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "10% off your first ritual" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Plus the four-step guide, restock alerts and nothing else. Roughly two emails a month.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send it" },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Unsubscribe any time. We never sell your data."
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
