<footer class="footer">
  <div class="container">

    <div class="footer__grid">
      <div>
        {%- comment -%}
          Set as type rather than an image: it stays crisp at any pixel density,
          costs no extra request, scales with the type system, and still reads
          if images fail to load.
        {%- endcomment -%}
        <a href="{{ routes.root_url }}" class="footer__wordmark">
          {{ shop.name }}<sup>&reg;</sup>
        </a>

        {%- if settings.brand_tagline != blank -%}
          <p class="footer__tagline">{{ settings.brand_tagline }}</p>
        {%- endif -%}

        {%- if settings.brand_blurb != blank -%}
          <p style="font-size:var(--fs-sm);max-width:42ch;">{{ settings.brand_blurb }}</p>
        {%- endif -%}

        {% render 'social-links' %}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              <ul class="footer__list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'pages' -%}
            {%- comment -%}
              Lists every visible page automatically, so a page added or hidden
              in the admin appears or disappears here with no menu to maintain.
              Hidden pages have no published_at, which is what filters them out.
            {%- endcomment -%}
            <div {{ block.shopify_attributes }}>
              <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              <ul class="footer__list">
                {%- for page in pages -%}
                  {%- if page.published_at and page.title != blank -%}
                    <li><a href="{{ page.url }}">{{ page.title }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
                {%- if block.settings.show_policies -%}
                  {%- for policy in shop.policies -%}
                    {%- if policy != blank -%}
                      <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </div>

          {%- when 'text' -%}
            <div {{ block.shopify_attributes }}>
              <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              <div style="font-size:var(--fs-sm);">{{ block.settings.text }}</div>
            </div>

          {%- when 'newsletter' -%}
            <div {{ block.shopify_attributes }}>
              <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              <p style="font-size:var(--fs-sm);">{{ block.settings.text }}</p>

              {%- form 'customer', class: 'newsletter__form', style: 'margin-top:1rem;' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="visually-hidden" for="FooterEmail">{{ 'general.newsletter.label' | t }}</label>
                <input
                  class="input"
                  id="FooterEmail"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  required
                  placeholder="{{ 'general.newsletter.placeholder' | t }}"
                  style="background:rgba(250,249,247,0.08);border-color:rgba(250,249,247,0.28);color:var(--o-paper);"
                >
                <button type="submit" class="btn btn--light">{{ 'general.newsletter.button' | t }}</button>
              {%- endform -%}

              <p class="newsletter__success" data-newsletter-success hidden>
                {{ 'general.newsletter.success' | t }}
              </p>
              <p style="font-size:var(--fs-xs);opacity:0.66;margin-top:0.75rem;">
                {{ 'general.newsletter.consent' | t }}
              </p>
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      {%- comment -%}
        The year has to be computed before it is passed to `t`. A pipe cannot
        appear inside a filter argument: Liquid reads it as a second filter, so
        `| t: year: 'now' | date: '%Y', shop: shop.name` hands `date` three
        arguments when it takes one or two.
      {%- endcomment -%}
      {%- assign current_year = 'now' | date: '%Y' -%}
      <p style="margin:0;">
        {{ 'sections.footer.copyright' | t: year: current_year, shop: shop.name }}
        {%- if section.settings.show_policy_links -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank %} &middot; <a href="{{ policy.url }}">{{ policy.title }}</a>{% endif -%}
          {%- endfor -%}
        {%- endif -%}
      </p>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__payments" role="list" aria-label="{{ 'sections.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <span role="listitem">{{ type | payment_type_svg_tag: class: 'payment-icon' }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_policy_links", "label": "Show policy links", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "pages",
      "name": "All pages (automatic)",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Lists every visible page in the store. Hide a page in Online Store → Pages and it disappears from here automatically."
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" },
        { "type": "checkbox", "id": "show_policies", "label": "Also list store policies", "default": true }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Made responsibly" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Formulated and filled in a certified Canadian facility. Bottled in recyclable Italian glass. Never tested on animals.</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join the 1%" },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Ritual guides, restock alerts and 10% off your first order."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "text" },
      { "type": "newsletter" }
    ]
  },
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
