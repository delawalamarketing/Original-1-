{%- paginate collection.products by section.settings.products_per_page -%}

  <div class="container">

    <header class="collection__header">
      <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs.aria_label' | t }}" style="text-align:center;">
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ collection.title }}</span>
      </nav>

      <h1>{{ collection.title }}</h1>

      {%- if collection.description != blank and section.settings.show_description -%}
        <div class="lede flow-center rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- if section.settings.show_toolbar -%}
      <div class="collection__toolbar">
        <span class="collection__count">
          {{ 'products.facets.product_count' | t: count: collection.products_count }}
        </span>

        <form method="get" style="display:flex;align-items:center;gap:0.75rem;">
          {%- comment -%} Preserve any active filters when sorting {%- endcomment -%}
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
            {%- endfor -%}
          {%- endfor -%}

          <label class="field__label" for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
          <select class="select" id="SortBy" name="sort_by" data-auto-submit style="min-height:42px;width:auto;">
            {%- assign current = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == current %}selected{% endif %}>
                {{ option.name }}
              </option>
            {%- endfor -%}
          </select>
          <noscript><button type="submit" class="btn btn--secondary" style="min-height:42px;">{{ 'products.facets.apply' | t }}</button></noscript>
        </form>
      </div>
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      <div class="collection__grid">
        {%- for product in collection.products -%}
          {% render 'product-card',
               product: product,
               index: forloop.index0,
               lazy: forloop.index > 4 %}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" rel="prev" aria-label="{{ 'general.pagination.previous' | t }}">&larr;</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
            {%- else -%}
              <span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" rel="next" aria-label="{{ 'general.pagination.next' | t }}">&rarr;</a>
          {%- endif -%}
        </nav>
      {%- endif -%}

    {%- else -%}
      <div class="cart-empty">
        <p class="lede">{{ 'sections.collection.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn">
          {{ 'sections.collection.browse_all' | t }}
        </a>
      </div>
    {%- endif -%}

  </div>

{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8, "max": 48, "step": 4, "default": 24
    },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "checkbox", "id": "show_toolbar", "label": "Show sort bar", "default": true }
  ]
}
{% endschema %}
