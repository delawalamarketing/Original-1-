{%- comment -%}
  Central icon set. One stroke weight (1.5), one grid (24), one join style —
  mixed icon sets are the fastest way to make a premium store look cheap.

  Usage: {% render 'icon', name: 'cart', size: 22 %}
{%- endcomment -%}

{%- liquid
  assign s = size | default: 20
-%}

{%- case name -%}

  {%- when 'cart' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M6.5 8h11l-1 11.5a1.5 1.5 0 0 1-1.5 1.4H9a1.5 1.5 0 0 1-1.5-1.4L6.5 8Z"/>
      <path d="M9.5 10V6.8a2.5 2.5 0 0 1 5 0V10"/>
    </svg>

  {%- when 'search' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false">
      <circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>
    </svg>

  {%- when 'account' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="9" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/>
    </svg>

  {%- when 'menu' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false">
      <path d="M4 7h16M4 12h16M4 17h16"/>
    </svg>

  {%- when 'close' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false">
      <path d="M6 6l12 12M18 6 6 18"/>
    </svg>

  {%- when 'check' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    </svg>

  {%- when 'check-circle' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="9"/><path d="m8 12.3 2.6 2.6L16 9.5"/>
    </svg>

  {%- when 'arrow-right' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M4 12h15m-5.5-5.5L19 12l-5.5 5.5"/>
    </svg>

  {%- when 'leaf' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M20 4c0 8.5-4.6 13-11 13H5.5C5.5 9.8 10.8 4 20 4Z"/><path d="M5 20c1.8-5.2 5-8.6 9.5-10.5"/>
    </svg>

  {%- when 'bottle' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M10 2.5h4v3h-4z"/><path d="M9 5.5h6a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2v-12a2 2 0 0 1 2-2Z"/><path d="M7 11h10"/>
    </svg>

  {%- when 'shield' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 3 5 6v6c0 4.4 3 8 7 9 4-1 7-4.6 7-9V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>
    </svg>

  {%- when 'rabbit' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M8.5 10C7 8 6.5 4.5 8 3.2c1.4-1.2 2.7 1 3 3.3"/>
      <path d="M13 10c-.3-2.5.6-5.6 2.3-5.6 1.7 0 1.6 3.6.4 5.6"/>
      <path d="M6.5 14.5a5 5 0 0 1 5-4.5h.4a5 5 0 0 1 5 4.7c.1 2.3-1 5.3-5.2 5.3-4 0-5.3-3-5.2-5.5Z"/>
      <circle cx="10" cy="15" r=".6" fill="currentColor" stroke="none"/>
      <circle cx="14" cy="15" r=".6" fill="currentColor" stroke="none"/>
    </svg>

  {%- when 'maple' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m12 3 1.9 3.7 2.3-.6-.7 2.4 3.5-1-1.6 2.6 2.1.8-2.6 2 .6 1.5-4.3-.8.5 4.9h-3.4l.5-4.9-4.3.8.6-1.5-2.6-2 2.1-.8L4.9 7.5l3.6 1-.8-2.4 2.4.6L12 3Z"/>
    </svg>

  {%- when 'truck' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M2.5 6.5h11v10h-11z"/><path d="M13.5 10h3.6l2.9 3v3.5h-6.5"/>
      <circle cx="7" cy="17.5" r="1.8"/><circle cx="16.5" cy="17.5" r="1.8"/>
    </svg>

  {%- when 'return' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M4 9a8 8 0 1 1 .8 7"/><path d="M3.5 4v5h5"/>
    </svg>

  {%- when 'lock' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8.5 10.5V7.8a3.5 3.5 0 0 1 7 0v2.7"/>
    </svg>

  {%- when 'flask' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M10 3v6.2L5.2 17.6A2 2 0 0 0 6.9 20.6h10.2a2 2 0 0 0 1.7-3L14 9.2V3"/><path d="M8.5 3h7"/><path d="M7.7 14.5h8.6"/>
    </svg>

  {%- when 'droplet' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 3.2c3.2 3.6 5.5 6.4 5.5 9.3a5.5 5.5 0 0 1-11 0c0-2.9 2.3-5.7 5.5-9.3Z"/>
    </svg>

  {%- when 'star' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="m12 3.6 2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8L3.5 9.8l5.9-.9L12 3.6Z"/>
    </svg>

  {%- when 'star-outline' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m12 3.6 2.6 5.3 5.9.9-4.2 4.1 1 5.8-5.3-2.8-5.3 2.8 1-5.8L3.5 9.8l5.9-.9L12 3.6Z"/>
    </svg>

  {%- when 'instagram' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.6"/><circle cx="16.8" cy="7.2" r="1" fill="currentColor" stroke="none"/>
    </svg>

  {%- when 'tiktok' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M16.2 3h-2.6v11.6a2.3 2.3 0 1 1-2.3-2.3c.2 0 .4 0 .6.1V9.7a5 5 0 1 0 4.3 4.9V9.1a6 6 0 0 0 3.4 1.1V7.6a3.5 3.5 0 0 1-3.4-3.4V3Z"/>
    </svg>

  {%- when 'facebook' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.63A22 22 0 0 0 14.3 3.5c-2.4 0-4 1.46-4 4.15v2.25H7.6V13h2.7v8h3.2Z"/>
    </svg>

  {%- when 'youtube' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M21.6 8.1a2.5 2.5 0 0 0-1.75-1.77C18.3 5.9 12 5.9 12 5.9s-6.3 0-7.85.43A2.5 2.5 0 0 0 2.4 8.1 26 26 0 0 0 2 12a26 26 0 0 0 .4 3.9 2.5 2.5 0 0 0 1.75 1.77c1.55.43 7.85.43 7.85.43s6.3 0 7.85-.43a2.5 2.5 0 0 0 1.75-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.4-3.9ZM10.2 15V9l5 3-5 3Z"/>
    </svg>

  {%- when 'spinner' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
      <path d="M12 3a9 9 0 1 0 9 9" opacity=".9">
        <animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="0.8s" repeatCount="indefinite"/>
      </path>
    </svg>

  {%- when 'chevron-down' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m6 9.5 6 6 6-6"/>
    </svg>

{%- endcase -%}
