{%- liquid
  assign has_social = false
  if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_facebook != blank or settings.social_youtube != blank
    assign has_social = true
  endif
-%}

{%- if has_social -%}
  <ul class="footer__social" style="list-style:none;padding:0;">
    {%- if settings.social_instagram != blank -%}
      <li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener"
             aria-label="{{ 'general.social.instagram' | t }}"
             aria-describedby="a11y-new-window-message">{% render 'icon', name: 'instagram', size: 19 %}</a></li>
    {%- endif -%}
    {%- if settings.social_tiktok != blank -%}
      <li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener"
             aria-label="{{ 'general.social.tiktok' | t }}"
             aria-describedby="a11y-new-window-message">{% render 'icon', name: 'tiktok', size: 19 %}</a></li>
    {%- endif -%}
    {%- if settings.social_facebook != blank -%}
      <li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener"
             aria-label="{{ 'general.social.facebook' | t }}"
             aria-describedby="a11y-new-window-message">{% render 'icon', name: 'facebook', size: 19 %}</a></li>
    {%- endif -%}
    {%- if settings.social_youtube != blank -%}
      <li><a href="{{ settings.social_youtube }}" target="_blank" rel="noopener"
             aria-label="{{ 'general.social.youtube' | t }}"
             aria-describedby="a11y-new-window-message">{% render 'icon', name: 'youtube', size: 19 %}</a></li>
    {%- endif -%}
  </ul>
{%- endif -%}
