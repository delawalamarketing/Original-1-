<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <title>{{ shop.name }}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {{ content_for_header }}

    {%- liquid
      assign body_font = settings.type_body_font
      assign heading_font = settings.type_heading_font
    -%}
    <style>
      {{ body_font | font_face: font_display: 'swap' }}
      {{ heading_font | font_face: font_display: 'swap' }}
      :root {
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-display: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --o-bone: {{ settings.color_bone }};
        --o-paper: {{ settings.color_paper }};
        --o-ink: {{ settings.color_ink }};
        --o-forest: {{ settings.color_forest }};
        --o-sage: {{ settings.color_sage }};
        --o-teal: {{ settings.color_teal }};
        --o-brass: {{ settings.color_brass }};
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.classList.remove('no-js');</script>
  </head>

  <body class="template-password">
    <main style="min-height:100vh;display:grid;place-items:center;padding:2rem 1.25rem;">
      {{ content_for_layout }}
    </main>
    {{ powered_by_link }}
  </body>
</html>
