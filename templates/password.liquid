{% layout 'password' %}

<div class="container container--narrow" style="text-align:center;max-width:520px;">

  {%- if settings.logo -%}
    <img src="{{ settings.logo | image_url: width: 420 }}" alt="{{ shop.name }}"
         width="210" height="64" style="margin:0 auto 2rem;width:210px;height:auto;">
  {%- else -%}
    <h1 style="font-size:var(--fs-2xl);">{{ shop.name }}</h1>
  {%- endif -%}

  <p class="eyebrow">Opening soon</p>
  <h1 style="font-size:clamp(2rem,5vw,3rem);">{{ settings.brand_tagline | default: 'One percent more you, every day.' }}</h1>

  {%- if shop.password_message != blank -%}
    <div class="lede rte">{{ shop.password_message }}</div>
  {%- else -%}
    <p class="lede">
      A luxurious fusion of nature’s finest ingredients — meticulously crafted in a certified
      Canadian facility, formulated without parabens, and bottled in eco-friendly Italian glass.
    </p>
  {%- endif -%}

  {%- form 'customer', class: 'newsletter__form newsletter--center',
        style: 'margin:2rem auto 0;justify-content:center;' -%}
    <input type="hidden" name="contact[tags]" value="prelaunch">
    <label class="visually-hidden" for="PasswordEmail">{{ 'general.newsletter.label' | t }}</label>
    <input class="input" id="PasswordEmail" type="email" name="contact[email]"
           autocomplete="email" required placeholder="{{ 'general.newsletter.placeholder' | t }}">
    <button type="submit" class="btn">Notify me</button>
  {%- endform -%}

  {%- if form.posted_successfully? -%}
    <p class="newsletter__success" role="status">{{ 'general.newsletter.success' | t }}</p>
  {%- endif -%}

  {% render 'social-links' %}

  <hr class="rule">

  <details style="margin-top:1rem;">
    <summary style="cursor:pointer;font-size:var(--fs-sm);">Enter using password</summary>
    {%- form 'storefront_password', style: 'display:flex;gap:0.5rem;margin-top:1rem;justify-content:center;' -%}
      <label class="visually-hidden" for="StorefrontPassword">Password</label>
      <input class="input" id="StorefrontPassword" type="password" name="password"
             autocomplete="current-password" style="max-width:240px;border-radius:var(--radius-pill);">
      <button type="submit" class="btn">Enter</button>
    {%- endform -%}
    {%- if form.errors -%}
      <p class="field__error" role="alert">{{ form.errors.messages.form }}</p>
    {%- endif -%}
  </details>

</div>
