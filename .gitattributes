# Normalise to LF in the repository. Shopify serves theme files with LF, and
# without this a clone on macOS/Linux shows every Windows-committed file as
# entirely changed.
* text=auto eol=lf

# Binary - never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.mov binary
*.mp4 binary
